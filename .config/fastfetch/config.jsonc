{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "data",
        "source": "       \u001b[36m/\\\n      /  \\\n     \u001b[34m/    \\\n    /      \\\n   /   ,,   \\\n  /   |  |   \\\n /_-''    ''-_\\\u001b[0m\n\n   \u001b[1;35md u s k y\u001b[0m",
        "padding": {
            "top": 5,
            "left": 1,
            "right": 3
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        {
            "type": "title",
            "key": "{#36}╭─ {#35} user    ",
            "keyWidth": 14,
            "format": "{user-name} @ {host-name}"
        },
        {
            "type": "os",
            "key": "{#36}├─ {#34}󰣇 os      ",
            "keyWidth": 14,
            "format": "{2} {8}"
        },
        {
            "type": "kernel",
            "key": "{#36}├─ {#34} kernel  ",
            "keyWidth": 14,
            "format": "{2}"
        },
        {
            "type": "command",
            "key": "{#36}├─ {#34}󱦟 install ",
            "keyWidth": 14,
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "packages",
            "key": "{#36}├─ {#34}󰏖 pkgs    ",
            "keyWidth": 14
        },
        {
            "type": "localip",
            "key": "{#36}├─ {#34}󰩟 ip      ",
            "keyWidth": 14,
            "showPrefixLen": false,
            "format": "{ipv4}"
        },
        {
            "type": "custom",
            "format": "{#36}├─────────────────────────────────────────"
        },
        {
            "type": "wm",
            "key": "{#36}├─ {#35} wm      ",
            "keyWidth": 14,
            "format": "{1} ({3})"
        },
        {
            "type": "shell",
            "key": "{#36}├─ {#35} shell   ",
            "keyWidth": 14,
            "format": "{1}"
        },
        {
            "type": "terminal",
            "key": "{#36}├─ {#35} term    ",
            "keyWidth": 14,
            "format": "{1}"
        },
        {
            "type": "display",
            "key": "{#36}├─ {#35}󰍹 display ",
            "keyWidth": 14,
            "format": "{4}x{5} @ {3}Hz"
        },
        {
            "type": "custom",
            "format": "{#36}├─────────────────────────────────────────"
        },
        {
            "type": "cpu",
            "key": "{#36}├─ {#32}󰍛 cpu     ",
            "keyWidth": 14,
            "format": "{1}"
        },
        {
            "type": "command",
            "key": "{#36}├─ {#32}󰆧 arch    ",
            "keyWidth": 14,
            "text": "/lib/ld-linux-x86-64.so.2 --help | awk '/supported, searched/ {print $1; exit}'"
        },
        {
            "type": "gpu",
            "key": "{#36}├─ {#32}󰢮 gpu     ",
            "keyWidth": 14,
            "format": "{2}"
        },
        {
            "type": "memory",
            "key": "{#36}├─ {#32} memory  ",
            "keyWidth": 14,
            "format": "{1} / {2} ({3})"
        },
        {
            "type": "disk",
            "key": "{#36}├─ {#32}󰉉 disk    ",
            "keyWidth": 14,
            "folders": "/",
            "format": "{1} / {2} ({3}) - {9}"
        },
        {
            "type": "custom",
            "format": "{#36}├─────────────────────────────────────────"
        },
        {
            "type": "colors",
            "key": "{#36}╰─ {#37} colors  ",
            "keyWidth": 14,
            "symbol": "circle"
        }
    ]
}
