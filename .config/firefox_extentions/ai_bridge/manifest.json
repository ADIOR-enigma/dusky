{
  "manifest_version": 3,
  "name": "Local AI Web Bridge",
  "version": "1.0.0",
  "description": "Seamlessly bridges local AI tools & terminal CLI to web AI models (ChatGPT, Claude, Gemini, Meta AI).",
  "browser_specific_settings": {
    "gecko": {
      "id": "local-ai-bridge@local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "*://chatgpt.com/*",
    "*://chat.openai.com/*",
    "*://claude.ai/*",
    "*://meta.ai/*",
    "*://gemini.google.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:8765 ws://localhost:8765;"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://claude.ai/*",
        "*://meta.ai/*",
        "*://gemini.google.com/*"
      ],
      "js": ["content_main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://claude.ai/*",
        "*://meta.ai/*",
        "*://gemini.google.com/*"
      ],
      "js": ["content_isolated.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "Local AI Bridge - Connecting..."
  }
}