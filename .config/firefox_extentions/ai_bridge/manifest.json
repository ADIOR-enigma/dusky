{
  "manifest_version": 3,
  "name": "Local AI Web Bridge",
  "version": "1.0.0",
  "description": "Seamlessly bridges local AI tools & terminal CLI to web AI models (ChatGPT, Claude, Gemini, Meta AI).",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:8765 ws://localhost:8765 http://127.0.0.1:8765 http://localhost:8765 ws: http:;"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content_isolated.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content_main.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content_main.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "Local AI Bridge - Connecting..."
  }
}