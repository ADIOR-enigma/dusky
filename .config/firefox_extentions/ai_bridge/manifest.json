{
  "manifest_version": 3,
  "name": "Local AI Bridge",
  "version": "1.0.0",
  "description": "Bare-bones bridge: local terminal AI controls web AI via DOM",
  "browser_specific_settings": {
    "gecko": {
      "id": "local-ai-bridge@ff153.example",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://www.meta.ai/*",
    "https://meta.ai/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://www.meta.ai/*",
        "https://meta.ai/*"
      ],
      "js": [
        "content_main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://www.meta.ai/*",
        "https://meta.ai/*"
      ],
      "js": [
        "content_isolated.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Local AI Bridge - Disconnected"
  }
}