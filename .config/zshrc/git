# 1. Base Bare Repo Function & Alias
# Functions are globally accessible in subshells, functions, and scripts without relying on interactive alias expansion.
function git_dusky() {
    /usr/bin/git --git-dir="$HOME/dusky/" --work-tree="$HOME" "$@"
}

# 2. Add List Function (Filters missing files gracefully with warning fallback)
function git_dusky_add_list() {
    (
        cd "$HOME" || return 0
        if [[ ! -f .git_dusky_list ]]; then
            printf '\033[33m⚠ Warning: .git_dusky_list not found in %s — skipping manifest staging.\033[0m\n' "$HOME"
            git_dusky diff HEAD
            return 0
        fi

        local missing=()
        local valid=()
        local line clean

        while IFS= read -r line || [[ -n "$line" ]]; do
            clean="${line#"${line%%[![:space:]]*}"}"
            clean="${clean%"${clean##*[![:space:]]}"}"
            [[ -z "$clean" || "$clean" == \#* ]] && continue

            if [[ "$clean" == *[\*\?\[]* ]]; then
                local matches=( $~clean(N) )
                if (( ${#matches[@]} > 0 )); then
                    valid+=( "${matches[@]}" )
                else
                    missing+=( "$clean" )
                fi
            else
                if [[ -e "$clean" || -L "$clean" ]]; then
                    valid+=( "$clean" )
                else
                    missing+=( "$clean" )
                fi
            fi
        done < .git_dusky_list

        if (( ${#missing[@]} > 0 )); then
            printf '\033[33m⚠ Warning: %d file(s) in .git_dusky_list missing on disk:\033[0m\n' "${#missing[@]}"
            for m in "${missing[@]}"; do
                printf '  \033[90m➔ %s\033[0m\n' "$m"
            done
        fi

        if (( ${#valid[@]} > 0 )); then
            if ! printf '%s\0' "${valid[@]}" | git_dusky add --pathspec-from-file=- --pathspec-file-nul; then
                printf '\033[31m✖ git add failed for manifest paths\033[0m\n'
            fi
        fi

        if ! git_dusky add -u; then
            printf '\033[31m✖ git add -u failed\033[0m\n'
        fi
    )
    return 0
}

# 3. Alias for discarding all local changes (both staged and unstaged) and revert the state of tracked files to exactly match the last commit (HEAD), this is a destructive operation. (DANGER ZONE)
alias git_dusky_restore='echo "git --git-dir=$HOME/dusky/ --work-tree=$HOME reset --hard HEAD" && git_dusky reset --hard HEAD'

# 4. Delta/Diff
#    gitdelta        -> uncommitted working-tree changes vs HEAD (unchanged habit)
#    gitdelta <N>    -> Nth-most-recent commit: colored header (hash · author ·
#                       date · subject), per-file stat, full delta-rendered patch.
#                       1 = last commit, 2 = one older, …
function gitdelta() {
    if (( $# == 0 )); then
        git_dusky_add_list && git_dusky diff HEAD
        return $?
    fi

    local n="${1}"
    if [[ ! "$n" =~ ^[0-9]+$ ]] || (( n < 1 )); then
        echo "Usage: gitdelta [N]  —  no arg: uncommitted changes · 1 = last commit · 2 = one older · …"
        return 1
    fi

    if ! git_dusky rev-parse --verify --quiet "HEAD~$((n - 1))" >/dev/null; then
        echo "No commit that far back — history is shorter than ${n}."
        return 1
    fi

    git_dusky show \
        --color=always \
        --decorate=short \
        --date=format-local:'%Y-%m-%d %H:%M' \
        --format='%C(bold blue)󰏖 %h%C(reset) %C(bold green)%an%C(reset) %C(dim)%ad%C(reset)%d%n%C(bold yellow)%s%C(reset)' \
        --stat \
        --patch \
        "HEAD~$((n - 1))" \
        | delta --paging=never
}

# 5. Lazygit Bare Repo Alias
alias lazygit_dusky='lazygit --git-dir=$HOME/dusky/ --work-tree=$HOME'

# 6. Push a single file to dotfiles bare repo
function git_dusky_push() {
    local filepath="${1:-}"
    if [[ -z "$filepath" ]]; then
        echo "Usage: git_dusky_push <file_path>"
        return 1
    fi

    # Resolve relative path to HOME
    local rel_path
    rel_path=$(realpath --relative-to="$HOME" "$filepath" 2>/dev/null)
    if [[ $? -ne 0 || "$rel_path" == ../* ]]; then
        echo "Error: File must be within $HOME"
        return 1
    fi

    (
        cd "$HOME" || return 1

        if ! git_dusky add "$rel_path"; then
            echo "Error: git add failed — nothing committed or pushed."
            return 1
        fi

        echo -n "Commit message for '$rel_path': "
        local msg
        read -r msg
        if [[ -z "$msg" ]]; then
            echo "Aborted: Commit message is required."
            return 1
        fi

        if ! git_dusky commit -m "$msg ($rel_path)"; then
            echo "Commit failed — nothing pushed (working tree state untouched)."
            return 1
        fi

        if ! git_dusky push; then
            local br
            br=$(git_dusky branch --show-current)
            echo "Plain push failed — retrying with upstream setup (-u origin ${br:-main})..."
            git_dusky push -u origin "${br:-main}"
        fi
    )
}

# 7. Dusky Dotfiles Manager Dashboard Alias
alias dusky='~/user_scripts/git/git_dusky.py'

