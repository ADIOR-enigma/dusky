[Desktop Entry]
Type=Application
Name=Dusky Keylogger Dashboard
GenericName=Keystroke Statistics
Comment=Live keystroke statistics dashboard (Textual TUI)
Exec=kitty --class dusky_keylogger -e /home/dusk/contained_apps/uv/dusky_key_logger/bin/dusky dashboard
Terminal=false
Categories=Utility;System;
Keywords=dusky;keylogger;keys;keystroke;stats;typing;dashboard;wpm;
Icon=utilities-terminal
StartupNotify=true
StartupWMClass=dusky_keylogger
